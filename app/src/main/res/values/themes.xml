<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light: black on white. The window colour matches the Compose background so there is no flash on start. -->
    <style name="Theme.Athena" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/athena_background</item>
        <item name="android:windowSplashScreenBackground">@color/athena_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
