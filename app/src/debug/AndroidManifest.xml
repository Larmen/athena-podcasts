<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Debug builds only: Android 17 blocks apps from private-network addresses (such as the emulator's
      host at 10.0.2.2) unless they hold this permission. Release builds only talk to public feeds
      and do not declare it (constitution §5, NFR-003).
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />


    <application>
        <!-- Debug builds only: stand-in for the launcher's provider, for the instrumented tests. Not reachable by other apps. -->
        <provider
            android:name=".FakeLauncherProvider"
            android:authorities="se.anders.athenapodcaster.test.fakelauncher"
            android:exported="false" />
    </application>
</manifest>
